local function makeToggle(parent, txt, varName, cb)
    local b = new("TextButton", {Size=UDim2.new(1, 0, 0, 22), TextXAlignment=Enum.TextXAlignment.Center, TextSize=9, Font=Enum.Font.Gotham, AutoButtonColor=false, Parent=parent})
    new("UICorner", {CornerRadius=UDim.new(0,4)}, b)
    
    local function updateVisual(v)
        b.Text = txt..(v and " [ON]" or " [OFF]")
        b.TextColor3 = v and Color3.new(1,1,1) or Color3.fromRGB(120,120,120)
        b.BackgroundColor3 = v and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25)
    end
    
    b.MouseButton1Click:Connect(function()
        S[varName] = not S[varName]
        updateVisual(S[varName])
        if cb then cb(S[varName]) end
    end)
    
    updateVisual(S[varName])
    table.insert(toggleRegistry, {varName = varName, update = updateVisual})
end

local function makeSlider(parent, txt, varName, min, max, isInt, cb)
    local c = new("Frame", {Size=UDim2.new(1, 0, 0, 26), BackgroundTransparency=1, Parent=parent})
    local lbl = new("TextLabel", {Size=UDim2.new(1,0,0,12), BackgroundTransparency=1, TextColor3=Color3.fromRGB(150,150,150), TextSize=9, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Center, Parent=c})
    local bar = new("Frame", {Size=UDim2.new(1,0,0,5), Position=UDim2.new(0,0,0,16), BackgroundColor3=Color3.fromRGB(40,40,40), Parent=c})
    new("UICorner", {CornerRadius=UDim.new(1,0)}, bar)
    local fill = new("Frame", {BackgroundColor3=Color3.new(1,1,1), Parent=bar})
    new("UICorner", {CornerRadius=UDim.new(1,0)}, fill)
    
    local function updateVisual(v)
        lbl.Text = txt..": "..v
        fill.Size = UDim2.new((v-min)/(max-min), 0, 1, 0)
    end
    
    local drag = false
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UIS.InputChanged:Connect(function(i) 
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local p = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = min + (max - min) * p
            if isInt then v = math.floor(v + 0.5) end
            S[varName] = v
            updateVisual(v)
            if cb then cb(v) end
        end
    end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    
    updateVisual(S[varName])
    table.insert(sliderRegistry, {varName = varName, update = updateVisual})
end

