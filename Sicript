-- ===== ESP =====
local function applySettings(character)
    local data = espData[character]
    if not data then return end
    if data.highlight then
        data.highlight.Enabled             = Settings.ESPEnabled
        data.highlight.FillColor           = Settings.FillColor
        data.highlight.FillTransparency    = Settings.FillTransparency
        data.highlight.OutlineColor        = Settings.OutlineColor
        data.highlight.OutlineTransparency = Settings.OutlineTransparency
    end
    if data.billboard then
        data.billboard.Enabled     = Settings.ESPEnabled and (Settings.ShowName or Settings.ShowHealth)
        data.billboard.StudsOffset = Vector3.new(0, Settings.TextOffsetY, 0)
    end
    if data.nameLabel then
        data.nameLabel.Visible    = Settings.ShowName
        data.nameLabel.TextColor3 = Settings.TextColor
        data.nameLabel.TextSize   = Settings.TextSize
        data.nameLabel.Size       = UDim2.new(1, 0, 0, Settings.TextSize + 2)
    end
    if data.healthBar then
        data.healthBar.Visible = Settings.ShowHealth
    end
end

local function applyToAll()
    for c in pairs(espData) do applySettings(c) end
end

local function createESP(character)
    if espData[character] then return end
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    local head     = character:WaitForChild("Head", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not rootPart or not head or not humanoid then return end

    local player = Players:GetPlayerFromCharacter(character)
    local name   = player and player.Name or character.Name

    local highlight = Instance.new("Highlight")
    highlight.Name    = "ESP_Highlight"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name        = "ESP_NameTag"
    billboard.Adornee     = head
    billboard.Size        = UDim2.new(0, 120, 0, 28)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 500
    billboard.Parent      = character

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.Parent = billboard

    local layout = Instance.new("UIListLayout")
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment   = Enum.VerticalAlignment.Center
    layout.Parent = frame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 0, Settings.TextSize + 2)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = name
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.LayoutOrder = 1
    nameLabel.Parent = frame

    local healthBar = Instance.new("Frame")
    healthBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBar.BackgroundTransparency = 0.3
    healthBar.BorderSizePixel = 0
    healthBar.Size = UDim2.new(0.5, 0, 0, 2)
    healthBar.LayoutOrder = 2
    healthBar.Parent = frame

    local hbC = Instance.new("UICorner") hbC.CornerRadius = UDim.new(0, 1) hbC.Parent = healthBar

    local healthFill = Instance.new("Frame")
    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthFill.BorderSizePixel = 0
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.Parent = healthBar

    local hfC = Instance.new("UICorner") hfC.CornerRadius = UDim.new(0, 1) hfC.Parent = healthFill

    local conn = RunService.RenderStepped:Connect(function()
        if humanoid and humanoid.Parent then
            local pct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
            healthFill.Size = UDim2.new(pct, 0, 1, 0)
            if pct > 0.5 then
                healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            elseif pct > 0.25 then
                healthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                healthFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end)

    espData[character] = {
        highlight = highlight, billboard = billboard,
        nameLabel = nameLabel, healthBar = healthBar,
        healthFill = healthFill, healthConnection = conn,
    }
    applySettings(character)
end

local function removeESP(character)
    local d = espData[character]
    if not d then return end
    if d.healthConnection then d.healthConnection:Disconnect() end
    if d.highlight then d.highlight:Destroy() end
    if d.billboard then d.billboard:Destroy() end
    espData[character] = nil
end

local function setupPlayer(p)
    if p == LocalPlayer then return end
    if p.Character then createESP(p.Character) end
    p.CharacterAdded:Connect(function(c) task.wait(0.1) createESP(c) end)
    p.CharacterRemoving:Connect(removeESP)
end
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p) if p.Character then removeESP(p.Character) end end)

print("[ESP] ESP đã kích hoạt")

