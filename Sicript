-- ============================================
-- SKIP E - NÚT NHỎ + KÉO TỰ DO
-- ============================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ===== Trạng thái =====
local isEnabled = false
local originalDurations = setmetatable({}, { __mode = "k" })
local trackedPrompts = setmetatable({}, { __mode = "k" })

-- ===== Xử lý ProximityPrompt =====
local function applySkip(prompt)
    if not prompt:IsA("ProximityPrompt") or trackedPrompts[prompt] then return end
    trackedPrompts[prompt] = true
    originalDurations[prompt] = prompt.HoldDuration
    if isEnabled then prompt.HoldDuration = 0 end
end

local function scanPrompts()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then applySkip(obj) end
    end
end

game.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then applySkip(obj) end
end)

local function setEnabled(state)
    isEnabled = state
    for prompt, orig in pairs(originalDurations) do
        if prompt.Parent then
            prompt.HoldDuration = state and 0 or orig
        end
    end
    if state then scanPrompts() end
end

-- ===== GUI =====
local gui = Instance.new("ScreenGui")
gui.Name = "SkipEGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999
gui.Parent = playerGui

local SIZE = 40 -- kích thước nút nhỏ

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(SIZE, SIZE)
btn.Position = UDim2.fromOffset(20, 20)
btn.BackgroundColor3 = Color3.fromRGB(210, 55, 55)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 18
btn.Text = "E"          -- icon gọn
btn.BorderSizePixel = 0
btn.AutoButtonColor = false
btn.Parent = gui

Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0) -- tròn hoàn toàn

local stroke = Instance.new("UIStroke", btn)
stroke.Color = Color3.new(1, 1, 1)
stroke.Thickness = 1.5
stroke.Transparency = 0.3

-- Chấm nhỏ báo trạng thái ON
local dot = Instance.new("Frame", btn)
dot.Size = UDim2.fromOffset(8, 8)
dot.Position = UDim2.new(1, -10, 0, 2)
dot.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
dot.BorderSizePixel = 0
dot.Visible = false
Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

-- ===== Hiển thị =====
local COLOR_ON  = Color3.fromRGB(45, 190, 85)
local COLOR_OFF = Color3.fromRGB(210, 55, 55)

local function refreshVisual()
    btn.BackgroundColor3 = isEnabled and COLOR_ON or COLOR_OFF
    dot.Visible = isEnabled
end

-- ===== KÉO THẢ TỰ DO =====
local DRAG_THRESHOLD = 5
local pressing = false
local dragging = false
local pressPos = Vector2.zero
local dragOffset = Vector2.zero
local moveConn

local function clampToScreen(x, y)
    local vp = workspace.CurrentCamera.ViewportSize
    local s = btn.AbsoluteSize
    return math.clamp(x, 0, vp.X - s.X), math.clamp(y, 0, vp.Y - s.Y)
end

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pressing = true
        dragging = false
        pressPos = Vector2.new(input.Position.X, input.Position.Y)

        local absPos = btn.AbsolutePosition
        dragOffset = Vector2.new(pressPos.X - absPos.X, pressPos.Y - absPos.Y)

        if moveConn then moveConn:Disconnect() end
        moveConn = UserInputService.InputChanged:Connect(function(i)
            if not pressing then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then return end

            local cur = Vector2.new(i.Position.X, i.Position.Y)

            -- Bắt đầu kéo khi vượt ngưỡng
            if not dragging and (cur - pressPos).Magnitude >= DRAG_THRESHOLD then
                dragging = true
            end

            if dragging then
                local nx, ny = clampToScreen(cur.X - dragOffset.X, cur.Y - dragOffset.Y)
                btn.Position = UDim2.fromOffset(nx, ny)
            end
        end)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not pressing then return end

    pressing = false
    if moveConn then moveConn:Disconnect(); moveConn = nil end

    -- Không kéo = click → toggle
    if not dragging then
        setEnabled(not isEnabled)
        refreshVisual()
    end
    dragging = false
end)

-- Hover
btn.MouseEnter:Connect(function() stroke.Transparency = 0 end)
btn.MouseLeave:Connect(function() stroke.Transparency = 0.3 end)

-- Phím tắt K
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        setEnabled(not isEnabled)
        refreshVisual()
    end
end)

-- Khởi tạo
scanPrompts()
refreshVisual()
