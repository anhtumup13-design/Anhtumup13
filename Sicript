local ESP_CONFIG = {
    FillColor = Color3.fromRGB(255, 0, 0), FillTransparency = 0.7,
    OutlineColor = Color3.fromRGB(255, 255, 255), OutlineTransparency = 0.5,
    TextColor = Color3.fromRGB(255, 255, 255), TextSize = 10, TextOffsetY = 2
}

local function new(c, p, parent)
    local o = Instance.new(c)
    for k, v in pairs(p) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

-- ===== LOGIC AIM ASSIST =====
local function getTarget()
    local cam, center = workspace.CurrentCamera, workspace.CurrentCamera.ViewportSize / 2
    local best, dist = nil, S.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local part = p.Character:FindFirstChild(S.Target) or p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part and not (S.TeamCheck and p.Team == LP.Team) then
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < dist then dist = d; best = part end
                end
            end
        end
    end
    return best
end

-- ===== LOGIC ESP =====
local espData = {}

local function updateESP(character)
    local data = espData[character]
    if not data then return end
    if data.highlight then data.highlight.Enabled = S.ESP end
    if data.billboard then 
        data.billboard.Enabled = S.ESP and (S.ShowName or S.ShowHealth)
        data.billboard.MaxDistance = S.ESPDistance
    end
    if data.nameLabel then data.nameLabel.Visible = S.ShowName end
    if data.healthBar then data.healthBar.Visible = S.ShowHealth end
end

local function updateAllESP()
    for char in pairs(espData) do updateESP(char) end
end

local function createESP(character)
    if espData[character] then return end
    local head = character:WaitForChild("Head", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not head or not humanoid then return end

    local player = Players:GetPlayerFromCharacter(character)
    local playerName = player and player.Name or character.Name

    local highlight = new("Highlight", {Adornee=character, FillColor=ESP_CONFIG.FillColor, FillTransparency=ESP_CONFIG.FillTransparency, OutlineColor=ESP_CONFIG.OutlineColor, OutlineTransparency=ESP_CONFIG.OutlineTransparency, DepthMode=Enum.HighlightDepthMode.AlwaysOnTop, Parent=character})
    local billboard = new("BillboardGui", {Adornee=head, Size=UDim2.new(0, 120, 0, 28), StudsOffset=Vector3.new(0, ESP_CONFIG.TextOffsetY, 0), AlwaysOnTop=true, LightInfluence=0, MaxDistance=S.ESPDistance, Parent=character})
    local frame = new("Frame", {BackgroundTransparency=1, Size=UDim2.new(1, 0, 1, 0), Parent=billboard})
    new("UIListLayout", {HorizontalAlignment=Enum.HorizontalAlignment.Center, VerticalAlignment=Enum.VerticalAlignment.Center, SortOrder=Enum.SortOrder.LayoutOrder, Parent=frame})

    local nameLabel = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.new(1, 0, 0, ESP_CONFIG.TextSize + 2), Font=Enum.Font.GothamBold, Text=playerName, TextColor3=ESP_CONFIG.TextColor, TextSize=ESP_CONFIG.TextSize, TextStrokeTransparency=0.5, TextStrokeColor3=Color3.new(0,0,0), LayoutOrder=1, Parent=frame})
    local healthBar = new("Frame", {BackgroundColor3=Color3.fromRGB(30, 30, 30), BackgroundTransparency=0.3, BorderSizePixel=0, Size=UDim2.new(0.5, 0, 0, 2), LayoutOrder=2, Parent=frame})
    new("UICorner", {CornerRadius=UDim.new(0, 1)}, healthBar)
    local healthFill = new("Frame", {BackgroundColor3=Color3.fromRGB(0, 255, 0), BorderSizePixel=0, Size=UDim2.new(1, 0, 1, 0), Parent=healthBar})
    new("UICorner", {CornerRadius=UDim.new(0, 1)}, healthFill)

    local healthConn = RunService.RenderStepped:Connect(function()
        if humanoid and humanoid.Parent then
            local pct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth,1), 0, 1)
            healthFill.Size = UDim2.new(pct, 0, 1, 0)
            healthFill.BackgroundColor3 = pct > 0.5 and Color3.fromRGB(0, 255, 0) or (pct > 0.25 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 0, 0))
        end
    end)

    espData[character] = {highlight=highlight, billboard=billboard, nameLabel=nameLabel, healthBar=healthBar, healthConnection=healthConn}
    updateESP(character)
end

local function removeESP(character)
    local data = espData[character]
    if not data then return end
    if data.healthConnection then data.healthConnection:Disconnect() end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    espData[character] = nil
end

local function setupPlayer(p)
    if p == LP then return end
    if p.Character then createESP(p.Character) end
    p.CharacterAdded:Connect(function(char) task.wait(0.1) createESP(char) end)
    p.CharacterRemoving:Connect(removeESP)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p) if p.Character then removeESP(p.Character) end end)

-- ===== LOGIC SPEED & JUMP =====
RunService.Stepped:Connect(function()
    if isDestroyed then return end
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local targetSpeed = S.SpeedEnabled and S.Speed or 16
            if hum.WalkSpeed ~= targetSpeed then hum.WalkSpeed = targetSpeed end
            
            local targetJump = S.JumpEnabled and S.Jump or 50
            if hum.UseJumpPower then
                if hum.JumpPower ~= targetJump then hum.JumpPower = targetJump end
            else
                if hum.JumpHeight ~= targetJump then hum.JumpHeight = targetJump end
            end
        end
    end
end)

