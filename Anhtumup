-- Logic kéo thả nút Toggle
local draggingToggle = false
local toggleStartPos = nil
local toggleDragStart = nil
local movedDistance = 0

toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingToggle = true
        toggleDragStart = input.Position
        toggleStartPos = toggleBtn.Position
        movedDistance = 0
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - toggleDragStart
        -- Tính khoảng cách đã di chuyển
        movedDistance = math.abs(delta.X) + math.abs(delta.Y)
        
        -- Di chuyển nút
        toggleBtn.Position = UDim2.new(
            toggleStartPos.X.Scale, toggleStartPos.X.Offset + delta.X,
            toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and draggingToggle then
        draggingToggle = false
        -- Nếu di chuyển dưới 10 pixel thì hiểu là "Bấm" (mở/đóng menu)
        if movedDistance < 10 then
            panel.Visible = not panel.Visible
        end
    end
end)

