-- ===== CÁC THÀNH PHẦN TRONG MENU =====
local function makeToggle(text, default, yPos, cb)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 26); btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = "  " .. text .. (default and "  [ON]" or "  [OFF]")
    btn.TextColor3 = default and Color3.fromRGB(255,255,255) or Color3.fromRGB(120,120,120)
    btn.TextSize = 11; btn.Font = Enum.Font.Gotham; btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = panel
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,4); bc.Parent = btn
    local s = default
    btn.MouseButton1Click:Connect(function()
        s = not s
        btn.Text = "  " .. text .. (s and "  [ON]" or "  [OFF]")
        btn.TextColor3 = s and Color3.fromRGB(255,255,255) or Color3.fromRGB(120,120,120)
        btn.BackgroundColor3 = s and Color3.fromRGB(40, 40, 40) or Color3.fromRGB(25, 25, 25)
        cb(s)
    end)
end

local function makeSlider(text, minVal, maxVal, defaultVal, isInt, yPos, cb)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 14); lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.BackgroundTransparency = 1; lbl.Text = text .. ": " .. defaultVal
    lbl.TextColor3 = Color3.fromRGB(150,150,150); lbl.TextSize = 10
    lbl.Font = Enum.Font.Gotham; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = panel

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 4); bar.Position = UDim2.new(0, 10, 0, yPos + 18)
    bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40); bar.Parent = panel
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1,0); bc.Parent = bar
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255); fill.Parent = bar
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1,0); fc.Parent = fill

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = minVal + (maxVal - minVal) * pos
        if isInt then val = math.floor(val + 0.5) end
        fill.Size = UDim2.new(pos, 0, 1, 0)
        lbl.Text = text .. ": " .. val
        cb(val)
    end

    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
end

