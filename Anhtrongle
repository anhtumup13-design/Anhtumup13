-- Hàm tạo Toggle/Slider
local function makeToggle(txt, def, y, cb)
    local b = new("TextButton", {Size=UDim2.new(1,-20,0,26), Position=UDim2.new(0,10,0,y), BackgroundColor3=def and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25), Text="  "..txt..(def and " [ON]" or " [OFF]"), TextXAlignment=Enum.TextXAlignment.Left, TextColor3=def and Color3.new(1,1,1) or Color3.fromRGB(120,120,120), TextSize=11, Font=Enum.Font.Gotham, AutoButtonColor=false, Parent=panel})
    new("UICorner", {CornerRadius=UDim.new(0,4)}, b)
    local state = def
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = "  "..txt..(state and " [ON]" or " [OFF]")
        b.TextColor3 = state and Color3.new(1,1,1) or Color3.fromRGB(120,120,120)
        b.BackgroundColor3 = state and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25)
        cb(state)
    end)
end

local function makeSlider(txt, min, max, def, int, y, cb)
    new("TextLabel", {Size=UDim2.new(1,-20,0,14), Position=UDim2.new(0,10,0,y), BackgroundTransparency=1, Text=txt..": "..def, TextColor3=Color3.fromRGB(150,150,150), TextSize=10, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left, Parent=panel})
    local bar = new("Frame", {Size=UDim2.new(1,-20,0,4), Position=UDim2.new(0,10,0,y+18), BackgroundColor3=Color3.fromRGB(40,40,40), Parent=panel})
    new("UICorner", {CornerRadius=UDim.new(1,0)}, bar)
    local fill = new("Frame", {Size=UDim2.new((def-min)/(max-min),0,1,0), BackgroundColor3=Color3.new(1,1,1), Parent=bar})
    new("UICorner", {CornerRadius=UDim.new(1,0)}, fill)
    local drag = false
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UIS.InputChanged:Connect(function(i) 
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local p = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = min + (max - min) * p
            if int then v = math.floor(v + 0.5) end
            fill.Size = UDim2.new(p, 0, 1, 0)
            cb(v)
        end
    end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
end

