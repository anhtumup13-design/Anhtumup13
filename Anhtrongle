-- Kéo thả
local function setupDraggable(gui, dragArea, onClick)
    local dragging, startPos, startInput, movedDist = false, nil, nil, 0
    dragArea.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startInput = i.Position; startPos = gui.Position; movedDist = 0
        end
    end)
    dragArea.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - startInput
            movedDist = movedDist + math.abs(delta.X) + math.abs(delta.Y)
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    dragArea.InputEnded:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if movedDist < 10 and onClick then onClick() end
        end
    end)
end
