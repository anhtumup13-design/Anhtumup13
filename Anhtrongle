-- Vòng lặp Aim
RunService:BindToRenderStep("Aim", Enum.RenderPriority.Camera.Value + 1, function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    fov.Visible = S.Enabled and S.ShowFOV
    if fov.Visible then
        fov.Position = UDim2.fromOffset(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        fov.Size = UDim2.fromOffset(S.FOV * 2, S.FOV * 2)
    end
    
    if not S.Enabled then return end
    local target = getTarget()
    if target then
        if S.Mode == "Camera" then
            cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.Position), S.Smooth)
        else
            local char = LP.Character
            if char and char.PrimaryPart then
                char.PrimaryPart.CFrame = char.PrimaryPart.CFrame:Lerp(CFrame.lookAt(char.PrimaryPart.Position, Vector3.new(target.Position.X, char.PrimaryPart.Position.Y, target.Position.Z)), S.Smooth)
            end
        end
    end
end)
